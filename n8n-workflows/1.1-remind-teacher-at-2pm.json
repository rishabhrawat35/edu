    {
      "parameters": {
        "jsCode": "// Nudge only if nothing was reported today.\nconst c = $('Config').first().json;\nconst values = $json.values || [];\nconst k = (values[0] || []).findIndex(x => String(x).trim() === 'Reported on');\nconst today = new Date().toISOString().slice(0, 10);\nif (k >= 0 && values.slice(1).some(r => String(r[k] || '').startsWith(today))) return [];\nconst body = ['Hi,', '', 'How did maths go today? Tell us in a 3-minute call:', c.call_link, '', 'Your plan: https://docs.google.com/spreadsheets/d/' + c.teacher_sheet_id + '/edit', '', 'Thanks,', 'Your maths helper'].join('\\n');\nconst raw = ['To: ' + c.teacher_email, 'Subject: How did maths go today?', 'Content-Type: text/plain; charset=UTF-8', '', body].join('\\r\\n');\nreturn [{ json: { raw: Buffer.from(raw).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '') } }];"
      },
